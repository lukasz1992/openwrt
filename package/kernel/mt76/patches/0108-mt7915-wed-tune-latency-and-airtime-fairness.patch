--- a/mt7915/debugfs.c
+++ b/mt7915/debugfs.c
@@ -220,6 +220,31 @@ static int mt7915_vow_atf_get(void *data
 DEFINE_DEBUGFS_ATTRIBUTE(fops_vow_atf, mt7915_vow_atf_get, mt7915_vow_atf_set,
 			 "%lld\n");
 
+static int mt7915_wed_tune_set(void *data, u64 val)
+{
+	struct mt7915_dev *dev = data;
+	int ret;
+
+	if (val > 3)
+		return -EINVAL;
+
+	mutex_lock(&dev->mt76.mutex);
+	WRITE_ONCE(mt7915_wed_tune, (unsigned int)val);
+	ret = mt7915_mcu_wed_tune_update(dev, true);
+	mutex_unlock(&dev->mt76.mutex);
+
+	return ret;
+}
+
+static int mt7915_wed_tune_get(void *data, u64 *val)
+{
+	*val = READ_ONCE(mt7915_wed_tune);
+	return 0;
+}
+
+DEFINE_DEBUGFS_ATTRIBUTE(fops_wed_tune, mt7915_wed_tune_get,
+			 mt7915_wed_tune_set, "%lld\n");
