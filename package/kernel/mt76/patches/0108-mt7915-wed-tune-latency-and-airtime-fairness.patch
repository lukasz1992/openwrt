+#define RED_GLOBAL_TOKEN_WATERMARK	2
+#define RED_BAND_TOKEN_WATERMARK	4
+#define RED_STA_AC_DROP_THRESHOLD	5
+#define RED_STA_AC_RESET_THRESHOLD	6
+
 static int mt7915_red_set_watermark(struct mt7915_dev *dev)
 {
-#define RED_GLOBAL_TOKEN_WATERMARK 2
 	struct {
 		__le32 args[3];
 		u8 cmd;
@@ -2407,5 +2411,229 @@ static int mt7915_red_set_watermark(stru
 				 sizeof(req), false);
 }
 
+static int mt7915_red_set_watermarks(struct mt7915_dev *dev,
+				     u16 all_hi, u16 all_lo,
+				     u16 b0_hi, u16 b0_lo,
+				     u16 b1_hi, u16 b1_lo)
+{
+	struct {
+		__le32 args[3];
+		u8 cmd;
+		u8 version;
+		u8 __rsv1[4];
+		__le16 len;
+		__le16 high_mark;
+		__le16 low_mark;
+		__le16 band_high_mark[2];
+		__le16 band_low_mark[2];
+		__le16 page_high_mark;
+		__le16 page_low_mark;
+	} __packed req = {
+		.args[0] = cpu_to_le32(MCU_WA_PARAM_RED_SETTING),
+		.cmd = RED_BAND_TOKEN_WATERMARK,
+		.len = cpu_to_le16(sizeof(req) - sizeof(req.args)),
+		.high_mark = cpu_to_le16(all_hi),
+		.low_mark = cpu_to_le16(all_lo),
+		.band_high_mark[0] = cpu_to_le16(b0_hi),
+		.band_high_mark[1] = cpu_to_le16(b1_hi),
+		.band_low_mark[0] = cpu_to_le16(b0_lo),
+		.band_low_mark[1] = cpu_to_le16(b1_lo),
+	};
+	int ret;
+
+	ret = mt76_mcu_send_msg(&dev->mt76, MCU_WA_PARAM_CMD(SET), &req,
+				sizeof(req), false);
+	if (ret < 0)
+		return ret;
+
+	req.cmd = RED_GLOBAL_TOKEN_WATERMARK;
+	return mt76_mcu_send_msg(&dev->mt76, MCU_WA_PARAM_CMD(SET), &req,
+				 sizeof(req), false);
+}
+
+static int mt7915_red_set_sta_dropth(struct mt7915_dev *dev, u16 wcid,
+				     u16 tokens, bool reset)
+{
+	struct {
+		__le32 args[3];
+		u8 cmd;
+		u8 version;
+		u8 __rsv1[4];
+		__le16 len;
+		__le16 wcid;
+		u8 ac;
+		u8 __rsv2;
+		__le16 token_dropth;
+		__le16 __rsv3;
+		__le16 page_dropth;
+		__le16 __rsv4[3];
+	} __packed req = {
+		.args[0] = cpu_to_le32(MCU_WA_PARAM_RED_SETTING),
+		.cmd = reset ? RED_STA_AC_RESET_THRESHOLD :
+			       RED_STA_AC_DROP_THRESHOLD,
+		.len = cpu_to_le16(sizeof(req) - sizeof(req.args)),
+		.wcid = cpu_to_le16(wcid),
+		.ac = 1, /* AC_BE in WA */
+		.token_dropth = cpu_to_le16(tokens),
+		.page_dropth = cpu_to_le16(tokens),
+	};
+
+	return mt76_mcu_send_msg(&dev->mt76, MCU_WA_PARAM_CMD(SET), &req,
+				 sizeof(req), false);
+}
+
+static int mt7915_wa_set_ac_tail_drop(struct mt7915_dev *dev, u8 band, u8 ac,
+				      u16 lower, u16 upper)
+{
+	u32 qidx = band * 5 + ac;
+	int ret;
+
+	ret = mt7915_mcu_wa_cmd(dev, MCU_WA_PARAM_CMD(SET),
+				MCU_WA_PARAM_AC_TAIL_DROP_UPPER, qidx, upper);
+	if (ret)
+		return ret;
+
+	return mt7915_mcu_wa_cmd(dev, MCU_WA_PARAM_CMD(SET),
+				 MCU_WA_PARAM_AC_TAIL_DROP_LOWER, qidx, lower);
+}
+
+static int mt7915_wa_set_target_delay(struct mt7915_dev *dev, u8 band, u16 ms)
+{
+	u32 us = min_t(u32, (u32)ms * 1000, 32767);
+	int ret;
+
+	ret = mt7915_mcu_wa_cmd(dev, MCU_WA_PARAM_CMD(SET),
+				MCU_WA_PARAM_RED_TARGET_BAND,
+				band ? dev->vow_atf_en : 0, 0);
+	if (ret)
+		return ret;
+
+	return mt7915_mcu_wa_cmd(dev, MCU_WA_PARAM_CMD(SET),
+				 MCU_WA_PARAM_RED_TARGET_DELAY, us, 0);
+}
+
+int mt7915_mcu_wed_tune_update(struct mt7915_dev *dev, bool force)
+{
+	static const u16 level_ms[] = { 0, 100, 25, 10 };
+	u32 max_rate_mbps[2] = { 72, 400 };
+	u8 level, band;
+	u16 target_ms, b_hi[2], b_lo[2], all_hi, all_lo;
+	int i, ret;
+
+	if (!mtk_wed_device_active(&dev->mt76.mmio.wed))
+		return 0;
+
+	level = min_t(unsigned int, READ_ONCE(mt7915_wed_tune), 3);
+	if (level != dev->wed_tune_level) {
+		dev->wed_tune_level = level;
+		force = true;
+	}
+
+	if (level == 0) {
+		if (!force)
+			return 0;
+
+		for (band = 0; band < 2; band++) {
+			u8 ac;
+
+			for (ac = 0; ac < 5; ac++)
+				mt7915_wa_set_ac_tail_drop(dev, band, ac,
+							   0, 0xffff);
+			mt7915_wa_set_target_delay(dev, band, 0);
+			dev->wed_band_hi[band] = 0;
+		}
+
+		rcu_read_lock();
+		for (i = 1; i < MT7915_WTBL_STA; i++) {
+			struct mt76_wcid *wcid = rcu_dereference(dev->mt76.wcid[i]);
+			struct mt7915_sta *msta;
+
+			if (!wcid || !wcid->sta)
+				continue;
+
+			msta = container_of(wcid, struct mt7915_sta, wcid);
+			msta->wed_tokens = 0;
+			mt7915_red_set_sta_dropth(dev, i, 0, true);
+		}
+		rcu_read_unlock();
+
+		return mt7915_red_set_watermarks(dev,
+						 MT7915_HW_TOKEN_SIZE - 256,
+						 MT7915_HW_TOKEN_SIZE - 256 - 1536,
+						 0x3e00, 0x3800,
+						 0x3e00, 0x3800);
+	}
+
+	target_ms = level_ms[level];
+
+	rcu_read_lock();
+	for (i = 1; i < MT7915_WTBL_STA; i++) {
+		struct mt76_wcid *wcid = rcu_dereference(dev->mt76.wcid[i]);
+		struct mt7915_sta *msta;
+		struct rate_info rate;
+		u32 rate_100k, rate_mbps, max_tok, tok, diff;
+
+		if (!wcid || !wcid->sta)
+			continue;
+
+		msta = container_of(wcid, struct mt7915_sta, wcid);
+		band = wcid->phy_idx ? 1 : 0;
+
+		spin_lock_bh(&dev->mt76.sta_poll_lock);
+		rate = wcid->rate;
+		spin_unlock_bh(&dev->mt76.sta_poll_lock);
+
+		rate_100k = cfg80211_calculate_bitrate(&rate);
+		rate_mbps = rate_100k ? max_t(u32, rate_100k / 10, 10) :
+					(band ? 400 : 72);
+		if (rate_mbps > max_rate_mbps[band])
+			max_rate_mbps[band] = rate_mbps;
+
+		max_tok = band ? 3072 : 1024;
+		tok = clamp_t(u32, (rate_mbps * target_ms) / 16, 36, max_tok);
+		diff = abs((int)tok - (int)msta->wed_tokens);
+		if (force || !msta->wed_tokens || diff > msta->wed_tokens / 5) {
+			msta->wed_tokens = tok;
+			mt7915_red_set_sta_dropth(dev, i, tok, false);
+		}
+	}
+	rcu_read_unlock();
+
+	b_hi[0] = clamp_t(u32, (max_rate_mbps[0] * target_ms) / 12, 64, 1024);
+	b_lo[0] = (b_hi[0] * 3) / 4;
+	b_hi[1] = clamp_t(u32, (max_rate_mbps[1] * target_ms) / 12, 192, 3072);
+	b_lo[1] = (b_hi[1] * 3) / 4;
+
+	if (!force &&
+	    abs((int)b_hi[0] - (int)dev->wed_band_hi[0]) <= dev->wed_band_hi[0] / 5 &&
+	    abs((int)b_hi[1] - (int)dev->wed_band_hi[1]) <= dev->wed_band_hi[1] / 5)
+		return 0;
+
+	dev->wed_band_hi[0] = b_hi[0];
+	dev->wed_band_hi[1] = b_hi[1];
+
+	all_hi = clamp_t(u32, (u32)b_hi[0] + b_hi[1], 256,
+			 MT7915_HW_TOKEN_SIZE - 256);
+	all_lo = (all_hi * 3) / 4;
+
+	ret = mt7915_red_set_watermarks(dev, all_hi, all_lo,
+					b_hi[0], b_lo[0], b_hi[1], b_lo[1]);
+	if (ret < 0)
+		return ret;
+
+	for (band = 0; band < 2; band++) {
+		u16 hi = b_hi[band];
+
+		mt7915_wa_set_ac_tail_drop(dev, band, 0, 32, max_t(u16, 48, hi / 2));
+		mt7915_wa_set_ac_tail_drop(dev, band, 1, 64, hi);
+		mt7915_wa_set_ac_tail_drop(dev, band, 2, 64, max_t(u16, 128, hi / 2));
+		mt7915_wa_set_ac_tail_drop(dev, band, 3, 64, max_t(u16, 96, hi / 4));
+		mt7915_wa_set_ac_tail_drop(dev, band, 4, 16, 128);
+		mt7915_wa_set_target_delay(dev, band, target_ms);
+	}
+
+	return 0;
+}
+
 static int mt7915_mcu_set_red(struct mt7915_dev *dev, bool enabled)
 {
 #define RED_DISABLE		0
@@ -2426,8 +2652,14 @@ static int mt7915_mcu_set_red(struct mt7
 	if (ret < 0)
 		return ret;
 
-	return mt7915_mcu_wa_cmd(dev, MCU_WA_PARAM_CMD(SET),
-				 MCU_WA_PARAM_RED, enabled, 0);
+	ret = mt7915_mcu_wa_cmd(dev, MCU_WA_PARAM_CMD(SET),
+				MCU_WA_PARAM_RED, enabled, 0);
+	if (ret < 0)
+		return ret;
+
+	if (enabled)
+		mt7915_mcu_wed_tune_update(dev, true);
+
+	return 0;
 }
 
